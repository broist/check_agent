[Unit]
Description=Monitorozo monitoring server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monitorozo-server
Group=monitorozo-server
ExecStart=/usr/local/bin/monitorozo-server -config /etc/monitorozo/server.yaml
EnvironmentFile=-/etc/monitorozo/server.env
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
StateDirectory=monitorozo-server
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/monitorozo-server
LimitNOFILE=4096
MemoryHigh=192M
MemoryMax=256M
UMask=0027

[Install]
WantedBy=multi-user.target
