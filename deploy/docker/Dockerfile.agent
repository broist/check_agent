# syntax=docker/dockerfile:1
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/monitorozo-agent ./cmd/agent

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/monitorozo-agent /monitorozo-agent
USER nonroot:nonroot
ENTRYPOINT ["/monitorozo-agent"]
CMD ["-config", "/etc/monitorozo/agent.yaml"]

